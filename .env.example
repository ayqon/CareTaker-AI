GEMINI_API_KEY=
SECRET_KEY=

# Required: Vertex AI config for Veo video generation
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Database (defaults to sqlite:///caretaker.db for local development)
# For Cloud Run with Cloud SQL (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Google Cloud Storage bucket for training videos (required for production)
GCS_BUCKET=

# Flask debug mode (set to 0 in production)
FLASK_DEBUG=1
